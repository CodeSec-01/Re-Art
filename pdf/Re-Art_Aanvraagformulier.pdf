ied Canvas", "V\('w3_cc_span'\)=='Ja' && V\('w3_cc_frame'\)=='Hout'", "Diepte frame \(hout\)"], ["w3_bc_uv", "Basic Canvas", "true", "UV-topcoating"], ["w3_bc_uvt", "Basic Canvas", "V\('w3_bc_uv'\)=='Ja'", "Type coating"], ["w3_bc_span", "Basic Canvas", "true", "Opspannen"], ["w3_bc_frame", "Basic Canvas", "V\('w3_bc_span'\)=='Ja'", "Type frame"], ["w3_bc_da", "Basic Canvas", "V\('w3_bc_span'\)=='Ja' && V\('w3_bc_frame'\)=='Aluminium'", "Diepte frame \(aluminium\)"], ["w3_bc_dh", "Basic Canvas", "V\('w3_bc_span'\)=='Ja' && V\('w3_bc_frame'\)=='Hout'", "Diepte frame \(hout\)"], ["w3_cp_cat", "Certified Paper", "true", "Papiersoort"], ["w3_cp_tm", "Certified Paper", "V\('w3_cp_cat'\)=='Matte paper'", "Matte paper - type"], ["w3_cp_tp", "Certified Paper", "V\('w3_cp_cat'\)=='Photo paper'", "Photo paper - type"], ["w3_cp_tx", "Certified Paper", "V\('w3_cp_cat'\)=='Metallic paper'", "Metallic paper - type"], ["w3_cp_blind", "Certified Paper", "true", "Blindpreeg"], ["w3_cp_num", "Certified Paper", "true", "Nummeren"], ["w3_cp_fin", "Certified Paper", "true", "Afwerking"], ["w3_cp_plak", "Certified Paper", "V\('w3_cp_fin'\)=='Opgeplakt'", "Opplakken op"], ["w3_cp_lijst", "Certified Paper", "V\('w3_cp_fin'\)=='Ingelijst'", "Lijst"], ["w3_cp_oph", "Certified Paper", "V\('w3_cp_fin'\)=='Opgeplakt' && V\('w3_cp_plak'\)!=CH", "Ophanging"], ["w3_bp_type", "Basic Paper", "true", "Papiertype"], ["w3_bp_blind", "Basic Paper", "true", "Blindpreeg"], ["w3_bp_num", "Basic Paper", "true", "Nummeren"], ["w3_bp_fin", "Basic Paper", "true", "Afwerking"], ["w3_bp_plak", "Basic Paper", "V\('w3_bp_fin'\)=='Opgeplakt'", "Opplakken op"], ["w3_bp_lijst", "Basic Paper", "V\('w3_bp_fin'\)=='Ingelijst'", "Lijst"], ["w3_bp_oph", "Basic Paper", "V\('w3_bp_fin'\)=='Opgeplakt' && V\('w3_bp_plak'\)!=CH", "Ophanging"], ["w3_hf_top", "HD Finish", "true", "Surface"], ["w3_hf_topf", "HD Finish", "V\('w3_hf_top'\)=='White surface'", "Afwerking white surface"], ["w3_hf_prof", "HD Finish", "true", "Type ophangprofiel"], ["w3_hdd_top", "HD Decor", "true", "Surface"], ["w3_hdd_topf", "HD Decor", "V\('w3_hdd_top'\)=='White surface'", "Afwerking white surface"], ["w3_hdd_prof", "HD Decor", "true", "Type ophangprofiel"], ["w3_sc_type", "Cruse Fine Art Scan", "true", "Type scan"], ["w3_sc_after", "Cruse Fine Art Scan", "true", "Na de scan"]]};\nfunction V\(n\) { var f = this.getField\(n\); return f ? f.valueAsString : ""; }\nfunction vis\(n\) { var f = this.getField\(n\); return f && f.display == display.visible; }\nfunction setVis\(n, on\) {\n  var d = on ? display.visible : display.hidden;\n  var f = this.getField\(n\); if \(f && f.display != d\) f.display = d;\n  var l = this.getField\("lbl_" + n\); if \(l && l.display != d\) l.display = d;\n}\nfunction reartUpdate\(\) {\n  for \(var n = 1; n <= N_WORKS; n++\) {\n    var p = V\("w" + n + "_prod"\);\n    var items = SPEC[n];\n    for \(var i = 0; i < items.length; i++\) {\n      var it = items[i];\n      setVis\(it[0], p == it[1] && eval\(it[2]\)\);\n    }\n    var chosen = p != CH && p != "";\n    setVis\("w" + n + "_size", chosen\);\n    var certOn = chosen && p != "Cruse Fine Art Scan";\n    setVis\("w" + n + "_cert", certOn\);\n    var c = certOn && V\("w" + n + "_cert"\) == "Ja";\n    var keys = ["cname", "catel", "cweb", "ctitle", "ced", "cea"];\n    for \(var k = 0; k < keys.length; k++\) setVis\("w" + n + "_" + keys[k], c\);\n    var tot = this.getField\("w" + n + "_ctot"\);\n    var ed = parseInt\(V\("w" + n + "_ced"\), 10\), ea = parseInt\(V\("w" + n + "_cea"\), 10\) || 0;\n    var txt = \(c && !isNaN\(ed\)\) ? "Totale editie \(editie + EA\): " + \(ed + ea\) : "";\n    if \(tot\) { if \(tot.value != txt\) tot.value = txt; tot.display = txt ? display.visible : display.hidden; }\n  }\n}\nfunction reartCheck\(\) {\n  var miss = [];\n  var req = [["naam", "Naam / bedrijfsnaam"], ["datum", "Datum"], ["email", "E-mailadres"]];\n  for \(var i = 0; i < req.length; i++\) if \(V\(req[i][0]\).replace\(/\\s/g, ""\) == ""\) miss.push\(req[i][1]\);\n  var em = V\("email"\);\n  if \(em && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test\(em\)\) miss.push\("E-mailadres is ongeldig"\);\n  var any = false;\n  for \(var n = 1; n <= N_WORKS; n++\) {\n    var p = V\("w" + n + "_prod"\);\n    if \(p == CH || p == ""\) { if \(n == 1\) miss.push\("Werk 1: type afwerking of dienst"\); continue; }\n    any = true;\n    var w = "Werk " + n + ": ";\n    var a = parseInt\(V\("w" + n + "_aantal"\), 10\);\n    if \(isNaN\(a\) || a < 1\) miss.push\(w + "aantal"\);\n    var items = SPEC[n];\n    for \(var i = 0; i < items.length; i++\) if \(vis\(items[i][0]\) && V\(items[i][0]\) == CH\) miss.push\(w + items[i][3].toLowerCase\(\)\);\n    if \(V\("w" + n + "_size"\).replace\(/\\s/g, ""\) == ""\) miss.push\(w + "titel & formaat kunstwerk"\);\n    if \(vis\("w" + n + "_cert"\)\) {\n      if \(V\("w" + n + "_cert"\) == CH\) miss.push\(w + "certificaat"\);\n      else if \(V\("w" + n + "_cert"\) == "Ja"\) {\n        if \(V\("w" + n + "_cname"\) == ""\) miss.push\(w + "naam kunstenaar"\);\n        if \(V\("w" + n + "_ctitle"\) == ""\) miss.push\(w + "titel werk"\);\n        if \(V\("w" + n + "_ced"\) == ""\) miss.push\(w + "editie"\);\n      }\n    }\n  }\n  return miss;\n}\nfunction reartSend\(\) {\n  var miss = reartCheck\(\);\n  if \(miss.length\) {\n    app.alert\({ cMsg: "Niet alles is ingevuld:\\n\\n\200 " + miss.slice\(0, 15\).join\("\\n\200 "\) + \(miss.length > 15 ? "\\n\200 \203" : ""\), cTitle: "Re-Art aanvraagformulier", nIcon: 1 }\);\n    return;\n  }\n  var naam = V\("naam"\);\n  try {\n    this.mailDoc\({ bUI: true, cTo: "info@re-art.com", cSubject: "Aanvraag Re-Art \205 " + naam,\n      cMsg: "Beste Re-Art,\\n\\nIn de bijlage vindt u mijn ingevulde aanvraagformulier.\\n\\nMet vriendelijke groet,\\n" + naam }\);\n  } catch \(e\) {\n    app.alert\("Het formulier kon niet automatisch worden gemaild. Sla de PDF op en stuur hem naar info@re-art.com."\);\n  }\n}\nfunction reartReset\(\) {\n  if \(app.alert\({ cMsg: "Weet u zeker dat u het hele formulier wilt leegmaken?", nIcon: 2, nType: 2 }\) == 4\) {\n    this.resetForm\(\); reartUpdate\(\);\n  }\n}\nreartUpdate\(\);\n) /S /JavaScript >>
endobj
